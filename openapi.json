   },
   "components":{
      "schemas":{
         "Body_create_job_jobs_post":{
            "properties":{
               "audio":{
                  "type":"string",
                  "format":"binary",
                  "title":"Audio"
               },
               "genre":{
                  "type":"string",
                  "enum":[
                     "pop",
                     "rock",
                     "metal",
                     "hip_hop",
                     "rnb",
                     "edm",
                     "electronic",
                     "jazz",
                     "classical",
                     "acoustic",
                     "folk",
                     "country",
                     "ambient",
                     "cinematic",
                     "reggae",
                     "latin",
                     "other"
                  ],
                  "title":"Genre"
               },
               "target_lufs":{
                  "type":"number",
                  "maximum":-6.0,
                  "minimum":-30.0,
                  "title":"Target Lufs"
               },
               "export_format":{
                  "type":"string",
                  "enum":[
                     "wav",
                     "m4a_aac",
                     "m4a_alac",
                     "flac",
                     "opus"
                  ],
                  "title":"Export Format"
               },
               "description":{
                  "type":"string",
                  "maxLength":4000,
                  "title":"Description",
                  "default":""
               }
            },
            "type":"object",
            "required":[
               "audio",
               "genre",
               "target_lufs",
               "export_format"
            ],
            "title":"Body_create_job_jobs_post"
         },
         "HTTPValidationError":{
            "properties":{
               "detail":{
                  "items":{
                     "$ref":"#/components/schemas/ValidationError"
                  },
                  "type":"array",
                  "title":"Detail"
               }
            },
            "type":"object",
            "title":"HTTPValidationError"
         },
         "RevisionRequest":{
            "properties":{
               "feedback":{
                  "type":"string",
                  "maxLength":4000,
                  "minLength":1,
                  "title":"Feedback"
               },
               "target_lufs":{
                  "anyOf":[
                     {
                        "type":"number",
                        "maximum":-6.0,
                        "minimum":-30.0
                     },
                     {
                        "type":"null"
                     }
                  ],
                  "title":"Target Lufs"
               },
               "export_format":{
                  "anyOf":[
                     {
                        "type":"string",
                        "enum":[
                           "wav",
                           "m4a_aac",
                           "m4a_alac",
                           "flac",
                           "opus"
                        ]
                     },
                     {
                        "type":"null"
                     }
                  ],
                  "title":"Export Format"
               },
               "genre":{
                  "anyOf":[
                     {
                        "type":"string",
                        "enum":[
                           "pop",
                           "rock",
                           "metal",
                           "hip_hop",
                           "rnb",
                           "edm",
                           "electronic",
                           "jazz",
                           "classical",
                           "acoustic",
                           "folk",
                           "country",
                           "ambient",
                           "cinematic",
                           "reggae",
                           "latin",
                           "other"
                        ]
                     },
                     {
                        "type":"null"
                     }
                  ],
                  "title":"Genre"
               }
            },
            "additionalProperties":false,
            "type":"object",
            "required":[
               "feedback"
            ],
            "title":"RevisionRequest"
         },
         "ValidationError":{
            "properties":{
               "loc":{
                  "items":{
                     "anyOf":[
                        {
                           "type":"string"
                        },
                        {
                           "type":"integer"
                        }
                     ]
                  },
                  "type":"array",
                  "title":"Location"
               },
               "msg":{
                  "type":"string",
                  "title":"Message"
               },
               "type":{
                  "type":"string",
                  "title":"Error Type"
               }
            },
            "type":"object",
            "required":[
               "loc",
               "msg",
               "type"
            ],
            "title":"ValidationError"
         }
      },
      "securitySchemes":{
         "HTTPBearer":{
            "type":"http",
            "scheme":"bearer"
         }
      }
   }
}